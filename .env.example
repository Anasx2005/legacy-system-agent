# PostgreSQL connection string
DATABASE_URL=postgresql://app_user:password@localhost:5432/legacy_db

# GitHub PAT (fine-grained, repo-scoped)
GITHUB_TOKEN=ghp_...

# GitHub model repo (org/repo)
GITHUB_MODEL_REPO=your-org/legacy-models

# Shared secret configured for GitHub's pull_request webhook.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret

# API key required by all Phase 1 orchestration and model-read endpoints.
API_KEY=replace-with-a-long-random-api-key

# LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-...
LANGCHAIN_PROJECT=legacy-system-agent


# Local evidence directory: agent can read but must never write here.
EVIDENCE_DIR=runtime/evidence

# Local Git checkout of the separate ArchiMate model repository.
MODEL_REPO_DIR=runtime/model-repo

# Directory name under /systems/ for this MVP legacy system.
MODEL_SYSTEM_ID=legacy-system

# Required by the configured ingestion model (https://ollama.com/settings/keys).
OLLAMA_API_KEY=ollama_...

# Hosted Ollama requests are retried when the provider returns a transient 5xx.
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_MAX_RETRIES=2

# Run analysts one at a time by default to avoid hosted-model 429 errors.
INGESTION_ANALYST_CONCURRENCY=1

