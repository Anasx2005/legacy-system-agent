# H3 API base URL. Do not include a trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Numeric legacy_systems.id in the backend database.
VITE_SYSTEM_ID=1

# Prefilled server-side path; it must match backend EVIDENCE_DIR.
VITE_EVIDENCE_PATH=runtime/evidence

# Optional development fallback. Prefer entering the key in the UI instead.
VITE_API_KEY=

# Used only to make evidence and PR links clickable.
VITE_GITHUB_MODEL_REPO=your-org/legacy-models
VITE_EVIDENCE_GITHUB_REPO=your-org/legacy-evidence
VITE_EVIDENCE_GITHUB_REF=main
